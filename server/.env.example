# ==============================================================================
# Bussy Bee Backend - Environment Configuration Example
# ==============================================================================

# Server Port (Internal port for Node.js Express backend)
PORT=5035

# Environment Mode (development / production)
NODE_ENV=production

# ------------------------------------------------------------------------------
# MongoDB Connection URI:
# Option 1: Local MongoDB running on VPS (Recommended for fast local database)
MONGODB_URI=mongodb://127.0.0.1:27017/bussy_bee

# Option 2: Local MongoDB with Authentication (if configured)
# MONGODB_URI=mongodb://bussy_user:YourStrongPassword@127.0.0.1:27017/bussy_bee?authSource=bussy_bee

# Option 3: MongoDB Atlas Cloud
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.txhuc3s.mongodb.net/bussy_bee?retryWrites=true&w=majority
# ------------------------------------------------------------------------------

# Frontend Client URLs for CORS (Comma-separated or * for wildcard)
CORS_ORIGIN=https://bussy-bee.gemshine.tech,http://bussy-bee.gemshine.tech,http://localhost:5035,http://127.0.0.1:5035,http://localhost:5173,http://127.0.0.1:5173
