# Frontend Client Environment Configuration (Vite)
# Copy this file to .env and adjust variables as needed.

# Backend API base URL
# Local Development: points to Express server running on port 5004
VITE_API_URL=http://localhost:5004/api

# Production options:
# When hosted on the same domain/subdomain with Nginx reverse proxy routing /api -> backend:
# VITE_API_URL=/api
# When backend is hosted on a separate domain/subdomain:
# VITE_API_URL=https://api.yourdomain.com/api
